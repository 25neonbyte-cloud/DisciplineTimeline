<Window x:Class="DisciplineTimeline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discipline Timeline"
        Width="1360"
        Height="890"
        MinWidth="1040"
        MinHeight="730"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Discipline Timeline"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedDateLabel}"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <DatePicker SelectedDate="{Binding SelectedDate}"
                            Width="150" />
                <Button Content="Anterior" Margin="8,0,0,0" Padding="10,6"
                        Command="{Binding PreviousDayCommand}" />
                <Button Content="Hoje" Margin="8,0,0,0" Padding="10,6"
                        Command="{Binding GoTodayCommand}" />
                <Button Content="Próximo" Margin="8,0,0,0" Padding="10,6"
                        Command="{Binding NextDayCommand}" />
                <Button Content="Carregar data"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Command="{Binding LoadSelectedDateCommand}" />
                <Button Content="Atualizar estados"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#33000000" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="TIMELINE | selecione um dia"
                           FontSize="12" FontWeight="SemiBold" Opacity="0.72"/>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TimelineDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,0" Padding="8,6" Width="113"
                                        Command="{Binding DataContext.NavigateToDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Date}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F2F3F5"/>
                                            <Setter Property="BorderBrush" Value="#D7D9DF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter Property="Background" Value="#E7E8EA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#1B70B5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#CFE4F8"/>
                                                    <Setter Property="BorderBrush" Value="#1660A0"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WeekDay}" FontSize="12" Opacity="0.7"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DayLabel}" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="4" Columns="8">
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Planejadas" Opacity="0.65" />
                    <TextBlock Text="{Binding PlannedCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Concluídas" Opacity="0.65" />
                    <TextBlock Text="{Binding CompletedCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Perdidas" Opacity="0.65" />
                    <TextBlock Text="{Binding LostCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Atrasadas" Opacity="0.65" />
                    <TextBlock Text="{Binding LateCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Bônus" Opacity="0.65" />
                    <TextBlock Text="{Binding BonusCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Consistência" Opacity="0.65" />
                    <TextBlock Text="{Binding ConsistencyLabel}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Execução" Opacity="0.65" />
                    <TextBlock Text="{Binding ExecutionLabel}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Padding="12" BorderBrush="#33000000"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Movidas do dia" Opacity="0.65" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MovedAwayCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tarefa"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Nova"
                                    Padding="10,4"
                                    Command="{Binding NewTaskCommand}" />
                        </Grid>

                        <TextBlock Text="Título" Margin="0,16,0,4" />
                        <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Descrição" Margin="0,12,0,4" />
                        <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="62"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />

                        <TextBlock Text="Categoria" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCategoryId}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Prioridade" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PriorityOptions}"
                                          SelectedItem="{Binding SelectedPriority}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Recorrência" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RecurrenceOptions}"
                                          SelectedItem="{Binding SelectedRecurrence}"
                                          IsEnabled="{Binding IsCreateMode}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Data / nova data de reagendamento" Margin="0,12,0,4" />
                        <DatePicker SelectedDate="{Binding TaskPlannedDate}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Início HH:mm" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PlannedStartText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fim HH:mm" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PlannedEndText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Definir data"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding CreateScheduledCommand}" />
                            <Button Content="Iniciar agora"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding StartNowCommand}" />
                            <Button Content="Salvar edição"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding SaveEditCommand}" />
                            <Button Content="Reagendar"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding RescheduleSelectedCommand}" />
                        </WrapPanel>

                        <Separator Margin="0,10" />

                        <WrapPanel>
                            <Button Content="Iniciar selecionada"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding StartSelectedCommand}" />
                            <Button Content="Concluir"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding CompleteSelectedCommand}" />
                            <Button Content="Cancelar"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding CancelSelectedCommand}" />
                            <Button Content="Recuperar bônus"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding RecoverSelectedCommand}" />
                            <Button Content="Excluir"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl Grid.Column="2">
                <TabItem Header="Demandas">
                    <Border BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Demandas do dia"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tarefa" Width="250" DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Categoria" Width="110" DisplayMemberBinding="{Binding Category.Name}" />
                                <GridViewColumn Header="Estado" Width="100" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Início" Width="72" DisplayMemberBinding="{Binding PlannedStartTime}" />
                                <GridViewColumn Header="Fim" Width="72" DisplayMemberBinding="{Binding PlannedEndTime}" />
                                <GridViewColumn Header="Atraso" Width="65" DisplayMemberBinding="{Binding HasLateFlag}" />
                                <GridViewColumn Header="Reag." Width="55" DisplayMemberBinding="{Binding RescheduleCount}" />
                                <GridViewColumn Header="Origem" Width="120" DisplayMemberBinding="{Binding Origin}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Métricas">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="RELATÓRIO MENSAL"
                                       FontWeight="SemiBold" FontSize="18"/>
                            <TextBlock Text="{Binding MonthLabel}" Margin="0,3,0,12"
                                       Opacity="0.7"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Planejadas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.Planned}" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Entrega" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyDeliveryLabel}" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Consistência" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyConsistencyLabel}" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Recuperadas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.Recovered}" FontSize="24"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Perdidas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.Lost}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Atrasos" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.Late}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Canceladas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.Cancelled}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Bônus no mês" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.RecoveredBonusesWithinPeriod}" FontSize="18"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Reagendadas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.Rescheduled}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Alterações" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.RescheduleChanges}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Média/tarefa" Opacity="0.65"/>
                                    <TextBlock Text="{Binding MonthlyMetrics.AverageRescheduleChanges, StringFormat={}{0:0.00}}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Dias 100% / parcial / zero" Opacity="0.65"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MonthlyMetrics.FullDays}" FontSize="18"/>
                                        <TextBlock Text=" / " FontSize="18"/>
                                        <TextBlock Text="{Binding MonthlyMetrics.PartialDays}" FontSize="18"/>
                                        <TextBlock Text=" / " FontSize="18"/>
                                        <TextBlock Text="{Binding MonthlyMetrics.ZeroDays}" FontSize="18"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>

                            <Separator Margin="0,16"/>
                            <TextBlock Text="MÉTRICAS POR CICLO"
                                       FontWeight="SemiBold" FontSize="18"/>
                            <ComboBox ItemsSource="{Binding Cycles}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedCycle}"
                                      Margin="0,10,0,12"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Planejadas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding CycleMetrics.Planned}" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Entrega" Opacity="0.65"/>
                                    <TextBlock Text="{Binding CycleDeliveryLabel}" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Consistência" Opacity="0.65"/>
                                    <TextBlock Text="{Binding CycleConsistencyLabel}" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Recuperadas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding CycleMetrics.Recovered}" FontSize="24"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Perdidas / canceladas" Opacity="0.65"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CycleMetrics.Lost}" FontSize="18"/>
                                        <TextBlock Text=" / " FontSize="18"/>
                                        <TextBlock Text="{Binding CycleMetrics.Cancelled}" FontSize="18"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Reagendadas" Opacity="0.65"/>
                                    <TextBlock Text="{Binding CycleMetrics.Rescheduled}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Alterações" Opacity="0.65"/>
                                    <TextBlock Text="{Binding CycleMetrics.RescheduleChanges}" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Dias 100% / parcial / zero" Opacity="0.65"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CycleMetrics.FullDays}" FontSize="18"/>
                                        <TextBlock Text=" / " FontSize="18"/>
                                        <TextBlock Text="{Binding CycleMetrics.PartialDays}" FontSize="18"/>
                                        <TextBlock Text=" / " FontSize="18"/>
                                        <TextBlock Text="{Binding CycleMetrics.ZeroDays}" FontSize="18"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="4,16,4,0" Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Text="Entrega do período inclui recuperações posteriores. Consistência mede conclusões na data operacional e não é reparada por recuperação. O período permanece ancorado nas datas originais; reagendamentos são medidos à parte. Dias futuros não são classificados como dias zerados."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>

<Window x:Class="DisciplineTimeline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discipline Timeline"
        Width="1320"
        Height="840"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Discipline Timeline"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedDateLabel}"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <DatePicker SelectedDate="{Binding SelectedDate}"
                            Width="150" />
                <Button Content="Carregar data"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Command="{Binding LoadSelectedDateCommand}" />
                <Button Content="Atualizar estados"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="6">
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Planejadas" Opacity="0.65" />
                    <TextBlock Text="{Binding PlannedCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Concluídas" Opacity="0.65" />
                    <TextBlock Text="{Binding CompletedCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Perdidas" Opacity="0.65" />
                    <TextBlock Text="{Binding LostCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Atrasadas" Opacity="0.65" />
                    <TextBlock Text="{Binding LateCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Bônus" Opacity="0.65" />
                    <TextBlock Text="{Binding BonusCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Padding="12" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Consistência" Opacity="0.65" />
                    <TextBlock Text="{Binding ConsistencyLabel}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tarefa"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="Nova"
                                    Padding="10,4"
                                    Command="{Binding NewTaskCommand}" />
                        </Grid>

                        <TextBlock Text="Título" Margin="0,16,0,4" />
                        <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Descrição" Margin="0,12,0,4" />
                        <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="62"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />

                        <TextBlock Text="Categoria" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCategoryId}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Prioridade" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PriorityOptions}"
                                          SelectedItem="{Binding SelectedPriority}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Recorrência" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RecurrenceOptions}"
                                          SelectedItem="{Binding SelectedRecurrence}"
                                          IsEnabled="{Binding IsCreateMode}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Data / nova data de reagendamento" Margin="0,12,0,4" />
                        <DatePicker SelectedDate="{Binding TaskPlannedDate}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Início HH:mm" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PlannedStartText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fim HH:mm" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PlannedEndText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Definir data"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding CreateScheduledCommand}" />
                            <Button Content="Iniciar agora"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding StartNowCommand}" />
                            <Button Content="Salvar edição"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding SaveEditCommand}" />
                            <Button Content="Reagendar"
                                    Padding="12,7"
                                    Margin="0,0,8,8"
                                    Command="{Binding RescheduleSelectedCommand}" />
                        </WrapPanel>

                        <Separator Margin="0,10" />

                        <WrapPanel>
                            <Button Content="Iniciar selecionada"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding StartSelectedCommand}" />
                            <Button Content="Concluir"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding CompleteSelectedCommand}" />
                            <Button Content="Cancelar"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding CancelSelectedCommand}" />
                            <Button Content="Recuperar bônus"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding RecoverSelectedCommand}" />
                            <Button Content="Excluir"
                                    Padding="10,6"
                                    Margin="0,0,8,8"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Demandas do dia"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tarefa" Width="250" DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Categoria" Width="110" DisplayMemberBinding="{Binding Category.Name}" />
                                <GridViewColumn Header="Estado" Width="100" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Início" Width="72" DisplayMemberBinding="{Binding PlannedStartTime}" />
                                <GridViewColumn Header="Fim" Width="72" DisplayMemberBinding="{Binding PlannedEndTime}" />
                                <GridViewColumn Header="Atraso" Width="65" DisplayMemberBinding="{Binding HasLateFlag}" />
                                <GridViewColumn Header="Reag." Width="55" DisplayMemberBinding="{Binding RescheduleCount}" />
                                <GridViewColumn Header="Origem" Width="120" DisplayMemberBinding="{Binding Origin}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

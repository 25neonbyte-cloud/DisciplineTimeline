<Window x:Class="DisciplineTimeline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discipline Timeline"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Discipline Timeline"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedDateLabel}"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Planejadas" Opacity="0.65" />
                    <TextBlock Text="{Binding PlannedCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Concluídas" Opacity="0.65" />
                    <TextBlock Text="{Binding CompletedCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Padding="16" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Atrasadas" Opacity="0.65" />
                    <TextBlock Text="{Binding LateCount}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Padding="16" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Consistência" Opacity="0.65" />
                    <TextBlock Text="{Binding ConsistencyLabel}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Hoje" FontSize="20" FontWeight="SemiBold" />

                <ListView Grid.Row="2" ItemsSource="{Binding Tasks}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tarefa" Width="340" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Categoria" Width="150" DisplayMemberBinding="{Binding Category.Name}" />
                            <GridViewColumn Header="Estado" Width="130" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Data planejada" Width="140" DisplayMemberBinding="{Binding CurrentPlannedDate}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
